# Supabase Environment Variables
# Copy this to .env.local and fill in your values from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ---------------------------------------------------------------
# Setup Instructions (Phase 0)
# ---------------------------------------------------------------
# 1. Create a project at https://supabase.com
# 2. Copy the Project URL and anon/public API key from:
#    Settings → API → Project URL & Project API keys
# 3. Fill in the values above and save as .env.local
# 4. Install Supabase CLI: npm install -g supabase
# 5. Link your project: supabase link --project-ref YOUR_PROJECT_ID
# 6. Apply the schema: supabase db push
#    OR: supabase migration up
# 7. Create your account in Supabase → Auth → Users → Add user
# 8. In Supabase → Storage, create a bucket named "body-progress"
#    and set it to private
# 9. Run: npm run dev
# ---------------------------------------------------------------
